{
  "manifest_version": 3,
  "name": "Product Price Scraper",
  "version": "1.0.0",
  "description": "Scrapes product data including prices from your logged-in wholesale vendor sessions",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.uttermost.com/*",
    "https://*.visualcomfort.com/*",
    "https://*.bernhardt.com/*",
    "https://*.reginaandrew.com/*",
    "https://*.hvlgroup.com/*",
    "https://*.loloirugs.com/*",
    "https://*.globalviews.com/*",
    "https://*.surya.com/*",
    "https://*.fourhands.com/*",
    "https://*.jaipurliving.com/*",
    "https://designready-1.preview.emergentagent.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.uttermost.com/*",
        "https://*.visualcomfort.com/*",
        "https://*.bernhardt.com/*",
        "https://*.reginaandrew.com/*",
        "https://*.hvlgroup.com/*",
        "https://*.loloirugs.com/*",
        "https://*.globalviews.com/*",
        "https://*.surya.com/*",
        "https://*.fourhands.com/*",
        "https://*.jaipurliving.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
