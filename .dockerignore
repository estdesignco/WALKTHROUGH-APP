# Backend .env structure is needed - secrets injected at runtime via start.sh
# .env files are safe - Kubernetes injects actual secrets at deployment time

# Frontend .env is safe (only has public backend URL) - needed for build
# NOT excluding frontend/.env

# Prevent cache from being deployed
**/__pycache__
**/*.pyc
**/*.pyo

# Development files
.git
.gitignore
*.log

# Electron builds - NOT needed for web deployment
frontend/dist-electron
frontend/ios
**/dist-electron

# Large cache directories
**/node_modules/.cache
frontend/node_modules/.cache

# Test and backup files
*_backup*
*_BACKUP*
tests/
test_reports/

# Unused directories
WALKTHROUGH-APP-WORKING-WITH-TRANSFER
WALKTHROUGH-APP-FURNITURE-SEARCH
FINAL-DELIVERY-PACKAGE
CANVA_SUBMISSION_PACKAGE
simple-test
COMPLETE_DEPLOYMENT_PACKAGE
canva-checklist-app
